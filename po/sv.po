#: lib/color.c:51
msgid ""
"colorize the output.  WHEN defaults to 'always' or can be 'auto' or 'never'"
msgstr ""
"färglägger utdata. WHEN är som standard 'always' men kan vara 'auto' eller "
"'never'"

#: lib/color.c:127
#, c-format
msgid ""
"%s: invalid argument '%s' for '--color'\n"
"valid arguments are:\n"
"  - 'always', 'yes', 'force'\n"
"  - 'never', 'no', 'none'\n"
"  - 'auto', 'tty', 'if-tty'\n"
msgstr ""
"%s: ogiltigt argument '%s' för '--color'\n"
"giltiga argument är:\n"
"  - 'always', 'yes', 'force'\n"
"  - 'never', 'no', 'none'\n"
"  - 'auto', 'tty', 'if-tty'\n"

